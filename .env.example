# Upstream Copilot client identity + API version (sent in proxy headers)
COPILOT_CHAT_VERSION=0.70.0
VSCODE_VERSION=1.142.0
GITHUB_API_VERSION=2026-08-01
PORT=4141

# GitHub host for the CAPI token exchange / device flow (omit for github.com),
# e.g. ghe.example.com; or pass --capi-ghe-host
CAPI_GHE_HOST=

# GitHub OAuth token used only for CAPI, kept separate from any GitHub PAT
# (generated by: npm run auth; or pass --capi-token)
CAPI_TOKEN=

# Copilot device IDs (generated by: npm run setup-device)
VSCODE_MACHINE_ID=
EDITOR_DEVICE_ID=

# Set to "true" to accept clients without an API key from keys.json; or pass --disable-client-auth
DISABLE_CLIENT_AUTH=false

# Client API keys file (default: keys.json in the working directory)
KEYS_FILE=

# Only read by the debug script `npm run fetch-models`
MODELS_API_VERSION=2026-06-01
