# Upstream Copilot client identity + API version (sent in proxy headers)
COPILOT_CHAT_VERSION=0.70.0
VSCODE_VERSION=1.142.0
GITHUB_API_VERSION=2026-08-01
PORT=4141

# GitHub Enterprise host (omit for github.com), e.g. ghe.example.com
GHE_HOST=

# GitHub token (generated by: bun run auth)
GITHUB_TOKEN=

# Copilot device IDs (generated by: bun run setup-device)
VSCODE_MACHINE_ID=
EDITOR_DEVICE_ID=

# Set to "true" to completely skip input API key validation
DISABLE_INPUT_AUTH=false

# Set to "true" to disable per-key usage logging to usage/*.jsonl
DISABLE_USAGE_LOGGING=false

# Only read by the debug script `bun run fetch-models`
MODELS_API_VERSION=2026-06-01
