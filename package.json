{
  "name": "copilot-provider",
  "main": "dist/index.js",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc",
    "dev": "node --env-file-if-exists=.env --watch index.ts",
    "auth": "node --env-file-if-exists=.env scripts/auth.ts",
    "setup-device": "node scripts/setup-device.ts",
    "gen-keys": "node scripts/gen-keys.ts",
    "fetch-models": "node --env-file-if-exists=.env scripts/fetch-models.ts",
    "usage-stats": "node scripts/usage-stats.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
