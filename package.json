{
  "name": "copilot-provider",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --watch index.ts",
    "auth": "node --env-file-if-exists=.env dist/scripts/auth.js",
    "setup-device": "node dist/scripts/setup-device.js",
    "gen-keys": "node dist/scripts/gen-keys.js",
    "fetch-models": "node --env-file-if-exists=.env dist/scripts/fetch-models.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
